Public Function Delete() As Boolean
    On Error GoTo ErrHandler
    
    Dim strQ As String
    Dim lngHowMany As Long
    Dim i As Long
    Dim strIDViaggio As String
    Dim VVC As CViaggioConsegna
    
    Dim VCA As CViaggioCarico
    
    DS.DA.BeginTransaction
    
    If Not IsUpdatable() Then
        GoTo ErrHandler
    End If
    
    Set VVC = New CViaggioConsegna
    With VVC
        Set .DS.DA = DS.DA
        strIDViaggio = DS.Fields("0").Value
        .DS.Fields("0").FindValue = strIDViaggio
        If .GetList Then
            lngHowMany = .DS.HowMany - 1
            For i = 0 To lngHowMany
                .DS.Fields("1").FindValue = .DS.List(0, i)
                .Find
                .Delete
            Next i
        End If
    End With
    
    ' --- Cancello i dati di carico del viaggio
    Set VCA = New CViaggioCarico
    With VCA
        Set .DS.DA = DS.DA
        If Not .DeleteLoadData(strIDViaggio) Then
            GoTo ErrHandler
        End If
    End With
    ' ---
    
    strQ = SQL_DELETE & DS.DA.MakeSQL(DS.Fields("0").Value, DS.Fields("0").FldType)
    
    If Not DS.DA.ExecuteQuery(strQ) Then
        GoTo ErrHandler
    End If
    
    DS.DA.EndTrans 0
    
    Set VVC = Nothing
    
    Set VCA = Nothing
    
    Delete = True
    
    Exit Function
    
ErrHandler:
    DS.DA.EndTrans 1
    Set VVC = Nothing
    Set VCA = Nothing
    Delete = False
End Function



Public Property Get TotaliQta(Index As Integer) As Variant
    If (Index >= LBound(mvarTotaliQta, 1)) And _
        (Index <= UBound(mvarTotaliQta, 1)) Then
        TotaliQta = mvarTotaliQta(Index, 0)
    End If
End Property

Public Property Get TotaliQtaProdotto() As Variant
    TotaliQtaProdotto = mvarTotaliQta
End Property

Private Sub Class_Terminate()
    Set DS = Nothing
End Sub


Private Sub DS_ClientClear()
    RaiseEvent ClientClear

End Sub

Private Sub DS_ClientRefresh()
    RaiseEvent ClientRefresh
End Sub
Private Function KNOSOS_InsertCarico(strTargaAutomezzo As String, _
                                        strKIdViaggio As String, _
                                        strKNumViaggio As String, _
                                        strDeposito As String, _
                                        strDataOraScaricoPrevisto As String)
On Error GoTo ErrHandler
    
    If Not DS.DA.ExecuteCommand(SQL_KNOSOS_CARICO_INSERT, _
                                TargaAutomezzo, _
                                KIdViaggio, _
                                KNumViaggio, _
                                KNOSOS_OPEVIAGGIO_IDSCARICO_CARICO, _
                                KNOSOS_OPEVIAGGIO_CODPROD_CARICO, _
                                KNOSOS_OPEVIAGGIO_TIPO_CARICO, _
                                KNOSOS_OPEVIAGGIO_STATO_RICHIESTA_CREAZIONE, _
                                Deposito, DataOraScaricoPrevisto) Then
        GoTo ErrHandler
    End If
    
    KNOSOS_InsertCarico = True
    Exit Function
    
ErrHandler:
    KNOSOS_InsertCarico = False
End Function

Private Function KNOSOS_InsertScarico(TargaAutomezzo As Variant, _
                                        KIdViaggio As Variant, _
                                        KNumViaggio As Variant, _
                                        IDScarico As Long, _
                                        CodProdotto As Variant, _
                                        NomeDestinatario As Variant, _
                                        Localita As Variant, _
                                        Indirizzo As Variant, _
                                        Telefono As Variant, _
                                        OraScarico As Variant, _
                                        OrarioApertura As Variant, _
                                        OraPrevistaArrivo As Variant, _
                                        DescrizioneProdotto As Variant, _
                                        Litri As Variant, _
                                        CodiceOrdine As Variant, _
                                        Note1 As Variant, _
                                        Note2 As Variant)
On Error GoTo ErrHandler
    
    If Not DS.DA.ExecuteCommand(SQL_KNOSOS_SCARICO_INSERT, _
                                TargaAutomezzo, _
                                KIdViaggio, _
                                KNumViaggio, _
                                IDScarico, _
                                CodProdotto, _
                                KNOSOS_OPEVIAGGIO_TIPO_SCARICO, _
                                KNOSOS_OPEVIAGGIO_STATO_RICHIESTA_CREAZIONE, _
                                NomeDestinatario, _
                                Localita, _
                                Indirizzo, _
                                Telefono, _
                                OraScarico, _
                                OrarioApertura, _
                                OraPrevistaArrivo, _
                                DescrizioneProdotto, _
                                Litri, _
                                CodiceOrdine, _
                                Note1, _
                                Note2) Then
        GoTo ErrHandler
    End If
    
    KNOSOS_InsertScarico = True
    Exit Function
    
ErrHandler:
    KNOSOS_InsertScarico = False
End Function
Public Function Insert_Sat() As Boolean

    Dim AAM As CAutomezzo
    Dim ADE As CDeposito

    Dim strKIdViaggio As String
    Dim strKNumViaggio As String
    Dim lngKIdScarico As Long

    Dim strIDAutomezzo As String
    Dim strIDDeposito As String
    Dim varBuffer As Variant
    Dim lngHowMany As Long
    Dim i As Long

    Dim blnSatellitareInstallato As Boolean
    Dim strTargaAutomezzo As String
    Dim strDataOraCarico As String
    Dim strDeposito As String
    
    ' Check stato = Definitivo
    ' TODO

    ' ------------------------------------------------------------------------
    ' Carica i dati dell'automezzo
    ' ------------------------------------------------------------------------
    ' Ricerca l'automezzo e carica i dati
    Set AAM = New CAutomezzo
    With AAM
        Set .DS.DA = DS.DA

        strIDAutomezzo = DS.Fields("15").Value
        .DS.Fields("0").FindValue = strIDAutomezzo

        If .Find = True And .DS.HowMany > 0 Then
            
            ' Imposta SatellitareInstallato a True o False
            blnSatellitareInstallato = .DS.Fields("34").Value
            strTargaAutomezzo = .DS.Fields("0").Value
        Else
            GoTo ErrHandler
        End If
    End With

    ' Se il satellitare non e' installato esce
    If blnSatellitareInstallato = False Then
        Insert_Sat = True
        Exit Function
    End If
    
    ' ------------------------------------------------------------------------
    ' Carica i dati del deposito
    ' ------------------------------------------------------------------------
    ' Ricerca il deposito e carica i dati
    Set ADE = New CDeposito
    With ADE
        Set .DS.DA = DS.DA

        strIDDeposito = DS.Fields("22").Value
        .DS.Fields("0").FindValue = strIDDeposito

        If .Find = True Then
            strDeposito = .DS.Fields("1").Value
        Else
            GoTo ErrHandler
        End If
    End With
    
    ' Inizia transazione
    DS.DA.BeginTransaction

    ' ------------------------------------------------------------------------
    ' Inserimento del viaggio
    ' ------------------------------------------------------------------------
    strKIdViaggio = DS.Fields("2").Value       ' Sequenza
    strKNumViaggio = DS.DA.GetCounter("anaganu0", "anuprogr", "anuidanu", "900", 0)
    strDataOraCarico = Format(DS.Fields("4").Value, "dd/mm/yy") & Format(DS.Fields("5").Value, "hh:mm")

    If Not DS.DA.ExecuteCommand(SQL_KNOSOS_VIAGGIO_INSERT, _
                                strTargaAutomezzo, _
                                strKIdViaggio, _
                                strKNumViaggio, _
                                KNOSOS_VIAGGIO_STATO_PENDENTE) Then
        GoTo ErrHandler
    End If

    ' TODO: Update strKNumViaggio sul viaggio resoil
    
    ' ------------------------------------------------------------------------
    ' Inserimento del carico
    ' ------------------------------------------------------------------------
    If Not DS.DA.ExecuteCommand(SQL_KNOSOS_CARICO_INSERT, _
                                strTargaAutomezzo, _
                                strKIdViaggio, _
                                strKNumViaggio, _
                                KNOSOS_OPEVIAGGIO_IDSCARICO_CARICO, _
                                KNOSOS_OPEVIAGGIO_CODPROD_CARICO, _
                                KNOSOS_OPEVIAGGIO_TIPO_CARICO, _
                                KNOSOS_OPEVIAGGIO_STATO_RICHIESTA_CREAZIONE, _
                                strDeposito, strDataOraCarico) Then
        GoTo ErrHandler
    End If
    
    ' ------------------------------------------------------------------------
    ' Inserimento degli scarichi dei prodotti
    ' ------------------------------------------------------------------------
    If Not DS.DA.QueryCommand(SQL_GET_LIST_KNOSOS_CONSEGNE_RESOIL, varBuffer, lngHowMany, DS.Fields("0")) Then
        GoTo ErrHandler
    End If

    For i = 0 To UBound(varBuffer, 2)
        
'       VIAGVVP0.VVPIDAPR, VIAGVVC0.VVCDERAS, VIAGVVC0.VVCDELOC,
'       VIAGVVC0.VVCDEIND, ANAGADZ0.ADZNRTEL, VIAGVVC0.VVCTEMVG,
'       VIAGVVP0.VVPQTRLT, VIAGVVC0.VVCIDOCT, VIAGVVC0.VVCNOTE1,
'       VIAGVVC0.VVCNOTEE
        
        lngKIdScarico = KNOSOS_GetNextIDScarico(strKIdViaggio)
        
        ' TODO: Aspettare informazioni sui campi
        If KNOSOS_InsertScarico(strTargaAutomezzo, _
                                strKIdViaggio, _
                                lngKIdScarico, _
                                strKNumViaggio, _
                                varBuffer(0, i), _
                                varBuffer(1, i), _
                                varBuffer(2, i), _
                                varBuffer(3, i), _
                                varBuffer(4, i), _
                                "", _
                                "", _
                                Format(varBuffer(5, i), "dd/mm/yy hh:mm"), _
                                "", _
                                Str(varBuffer(6, i)), _
                                Int(varBuffer(7, i)), _
                                varBuffer(8, i), _
                                varBuffer(9, i)) = False Then
            GoTo ErrHandler
        End If
    
        ' TODO: Update strKNumViaggio sul viaggio resoil

    Next i

    Set AAM = Nothing
    Set ADE = Nothing
    
    DS.DA.EndTrans etCommit

    Insert_Sat = True
    Exit Function

ErrHandler:
    Set AAM = Nothing
    Set ADE = Nothing
    
    Insert_Sat = False
    DS.DA.EndTrans etRollback
    
End Function
